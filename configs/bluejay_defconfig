# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The only kernel UFS component in the catalog is ShengUfs (SM8550). GS101 has
# no kernel storage driver yet, so the link must not ask for libShengUfs.a.
CONFIG_XNU_NATIVE_UFS=n
# NativeAES is built from the SoftwareAES component, which this board does not
# select, so the arch fragment's y would require an archive nothing builds.
CONFIG_XNU_NATIVE_AES=n
# build-gop-legacy-display.py is not in this tree and the board has no display
# driver to supply the probe, so the archive cannot exist.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
